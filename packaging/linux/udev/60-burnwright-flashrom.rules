# udev rules for the programmers burnwright drives through flashrom, shipped
# with burnwright. Today that's one: the CH341A the Laptop EC bench uses.
#
# They let an ordinary user open the programmer without sudo, the same two
# ways 60-burnwright-minipro.rules does for the XGecu programmers:
#   - TAG+="uaccess": the user logged in at the local seat gets an ACL on the
#     device (systemd-logind). This is what a desktop user relies on.
#   - GROUP="plugdev", MODE="0660": members of plugdev get access from any
#     session, including SSH or a headless box with no seat.
#
# The .deb installs this file to /usr/lib/udev/rules.d/. AppImage users copy it
# to /etc/udev/rules.d/ by hand: see docs/linux.md.
#
# 1a86:5512 is the CH341A in its SPI/I2C ("EPP/MEM") mode, the one flashrom's
# ch341a_spi opens. Its serial mode has another product ID and isn't listed:
# flashrom can't use it, and the kernel's serial driver owns it. The ID is the
# one flashrom's own util/flashrom_udev.rules lists. Not tested on real
# hardware yet.
#
# This is its own file and not a line in 60-burnwright-minipro.rules because
# the CH341A isn't a minipro device: it doesn't get ID_MINIPRO.
#
# The number keeps it ahead of systemd's 73-seat-late.rules, which turns the
# uaccess tag into an ACL.

ACTION!="add|change", GOTO="burnwright_flashrom_end"
SUBSYSTEM!="usb", GOTO="burnwright_flashrom_end"
ENV{DEVTYPE}!="usb_device", GOTO="burnwright_flashrom_end"

# CH341A (SPI/I2C mode)
ATTR{idVendor}=="1a86", ATTR{idProduct}=="5512", TAG+="uaccess", MODE="0660", GROUP="plugdev"

LABEL="burnwright_flashrom_end"
