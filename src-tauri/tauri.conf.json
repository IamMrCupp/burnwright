{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "burnwright",
  "version": "0.7.0",
  "identifier": "com.mrcupp.burnwright",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "burnwright",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/burnwright-minipro"
    ],
    "resources": {
      "binaries/minipro/*": "minipro/"
    },
    "linux": {
      "deb": {
        "depends": [
          "zlib1g"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-burnwright-minipro.rules": "../packaging/linux/udev/60-burnwright-minipro.rules"
        },
        "postInstallScript": "../packaging/linux/deb/postinst",
        "postRemoveScript": "../packaging/linux/deb/postrm"
      }
    }
  }
}
